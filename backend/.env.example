# Supabase Postgres connection string
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI, "Session" mode recommended for serverless-friendly pooling)
DATABASE_URL=postgres://user:password@host:5432/postgres

# Shared secret the external cron job (cron-job.org) must send as the
# x-scrape-secret header when calling POST /api/scrape/run
SCRAPE_SECRET=replace-with-a-long-random-string

# Port the Express server listens on (Render sets this automatically in production)
PORT=4000

# Base URL of the mock store being tracked
STORE_BASE_URL=https://demo.inelabteamdev.com

# Comma-separated list of allowed CORS origins (your Vercel frontend URL)
CORS_ORIGIN=http://localhost:5173
